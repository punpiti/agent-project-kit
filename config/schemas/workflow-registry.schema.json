{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://punpiti.github.io/agent-project-kit/schemas/workflow-registry.schema.json",
  "title": "Agent Project Kit workflow registry",
  "description": "Structure of config/workflow-registry.json. Cross-references (prompt files, policy ids) are checked by scripts/validate_prompt_catalog.py.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "pattern": "^prompts/[^/]+\\.md$"
    },
    "pipeline": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/$defs/text"
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^prompts/[^/]+\\.md$"
        },
        "instruction": {
          "$ref": "#/$defs/text"
        },
        "selectors": {
          "type": "object",
          "properties": {
            "deliverables": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "uniqueItems": true
            },
            "domains": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "uniqueItems": true
            },
            "methods": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "uniqueItems": true
            },
            "requires_method": {
              "type": "boolean"
            }
          },
          "required": [
            "deliverables",
            "domains",
            "methods"
          ],
          "additionalProperties": false
        },
        "compatibility_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "label",
        "prompt",
        "instruction",
        "selectors",
        "compatibility_keys"
      ],
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "properties": {
        "cadence": {
          "$ref": "#/$defs/text"
        },
        "instruction": {
          "$ref": "#/$defs/text"
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^prompts/[^/]+\\.md$"
        }
      },
      "required": [
        "cadence",
        "instruction",
        "prompt"
      ],
      "additionalProperties": false
    },
    "module_group": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/module"
      }
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "architecture": {
      "type": "object",
      "properties": {
        "owner": {
          "$ref": "#/$defs/text"
        },
        "selection_order": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 5,
          "items": {
            "enum": [
              "primary_pipeline",
              "method_modules",
              "lifecycle_stages",
              "quality_gates",
              "state_actions"
            ]
          }
        },
        "split_rule": {
          "$ref": "#/$defs/text"
        },
        "privacy_rule": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "owner",
        "selection_order",
        "split_rule",
        "privacy_rule"
      ],
      "additionalProperties": false
    },
    "composition": {
      "type": "object",
      "properties": {
        "primary_required": {
          "const": 1
        },
        "primary_max": {
          "const": 1
        },
        "method_max": {
          "type": "integer",
          "minimum": 1
        },
        "stage_max": {
          "type": "integer",
          "minimum": 1
        },
        "rule": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "primary_required",
        "primary_max",
        "method_max",
        "stage_max",
        "rule"
      ],
      "additionalProperties": false
    },
    "primary_pipelines": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/pipeline"
      }
    },
    "modules": {
      "type": "object",
      "properties": {
        "methods": {
          "$ref": "#/$defs/module_group"
        },
        "stages": {
          "$ref": "#/$defs/module_group"
        },
        "gates": {
          "$ref": "#/$defs/module_group"
        },
        "state_actions": {
          "$ref": "#/$defs/module_group"
        }
      },
      "required": [
        "methods",
        "stages",
        "gates",
        "state_actions"
      ],
      "additionalProperties": false
    },
    "policies": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/text"
      }
    },
    "always_policies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "prompt_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[^/]+\\.md$"
          },
          "legacy_type": {
            "enum": [
              "primary",
              "secondary",
              "one-time",
              "reference"
            ]
          },
          "role": {
            "enum": [
              "primary-pipeline",
              "method",
              "lifecycle-stage",
              "quality-gate",
              "state-action",
              "reference"
            ]
          },
          "cadence": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "trigger": {
            "$ref": "#/$defs/text"
          },
          "route": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "required": [
          "path",
          "legacy_type",
          "role",
          "cadence",
          "trigger"
        ],
        "additionalProperties": false
      }
    },
    "policy_sources": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[^#\\s][^#]*\\.md#\\S.*$"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "architecture",
    "composition",
    "primary_pipelines",
    "modules",
    "policies",
    "always_policies",
    "policy_sources",
    "prompt_inventory"
  ],
  "additionalProperties": false
}
